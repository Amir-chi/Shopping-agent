# Copy to .env and generate two different random secrets before starting.
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=nazdika
POSTGRES_USER=nazdika
POSTGRES_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
APP_PORT=8000
CATALOG_AUTO_IMPORT=true
CATALOG_IMPORT_PATH=/import/catalog.sqlite3
WEB_CONCURRENCY=2
NAZDIKA_FEED_KEYS={}
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
DJANGO_TRUST_PROXY=false
DJANGO_HSTS_SECONDS=0
# BoxAPI (OpenAI-style). Without a key the assistant falls back to rule-based search.
AI_BASE_URL=https://ai.boxapi.ir/ai/v1
AI_API_KEY=
# Model access must be enabled on the BoxAPI key.
AI_MODEL=openai/gpt-6-luna
AI_ROUTER_MODEL=typesafe/jev-1.14
# Optional visual outfit review; same existing key, no automatic calls on page refresh.
AI_OUTFIT_MODEL=openai/gpt-6-luna
# Optional automatic YouTube review discovery + native captions (NO paid audio generation).
# Set server-side only. Existing AI_API_KEY summarizes the returned captions in Persian.
SUPADATA_API_KEY=
# Optional comma-separated extra accounts, used only when the primary is capped or refused (caps apply per key).
SUPADATA_FALLBACK_KEYS=
SUPADATA_DAILY_LIMIT=6
SUPADATA_MONTHLY_LIMIT=60
# Fetch existing native captions and summarize them; still subject to the limits above.
VIDEO_REVIEW_SUMMARIES=true

# Seller panel: allow code-free demo login (read and answer only; never changes public prices). Real logins use codes from `manage.py seller_code <shop_id>`.
SELLER_DEMO=false
